DATABASE_URL=your_db_url
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
FRONTEND_ORIGIN=http://localhost:5190
# XERO_SCOPES=offline_access openid profile email accounting.contacts.read accounting.invoices.read
# Webhook key from Xero app → Webhooks. Delivery URL: https://cash-flow-5gdu.onrender.com/xero/webhooks
# XERO_WEBHOOK_KEY=
# Backup poll while the API is awake. Webhooks remain the real-time path.
# Keep this at 15 minutes or more. A short interval uses up Xero's daily API limit.
# XERO_SYNC_INTERVAL_SECONDS=900
# Optional: only needed if you connect multiple orgs and want a fixed one
# XERO_TENANT_ID=
